# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Allowed Origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# VLM Backend Configuration
# Supported options:
# - "heuristic": Fast local computer-vision & layout discrepancy analyzer (Zero-Day Brand Impersonation)
# - "mock": Instant mock responses for automated unit testing
# - "huggingface": Uses transformers Vision-Language Model (e.g. HuggingFaceTB/SmolVLM-Instruct, vikhyatk/moondream2)
VLM_BACKEND=heuristic
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-Instruct
DEVICE=cpu

# Fusion Weights (must sum to ~1.0)
WEIGHT_URL=0.20
WEIGHT_VISUAL=0.40
WEIGHT_TEXT=0.25
WEIGHT_HTML=0.15

# Risk Thresholds
THRESHOLD_SAFE=0.30
THRESHOLD_SUSPICIOUS=0.65

# Security, Concurrency & Sandboxing Settings
SSRF_PROTECTION_ENABLED=True
PAGE_FETCH_TIMEOUT_SECONDS=15
MAX_HTML_SIZE_BYTES=5242880
RATE_LIMIT_PER_MINUTE=60
API_KEY=
MAX_CONCURRENT_BROWSERS=3
SCREENSHOT_TTL_SECONDS=3600

# ML Baseline Model
ENABLE_ML_BASELINE=True

# Database
DATABASE_URL=sqlite:///./backend/data/phishing_scans.db
