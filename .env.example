# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Allowed Origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# VLM Configuration
# Options: "mock" (fastest, zero download), "heuristic" (computer vision + layout discrepancy), 
# or Hugging Face model IDs like "HuggingFaceTB/SmolVLM-Instruct" / "vikhyatk/moondream2"
VLM_BACKEND=heuristic
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-Instruct
DEVICE=cpu

# Fusion Weights (must sum to ~1.0)
WEIGHT_URL=0.20
WEIGHT_VISUAL=0.40
WEIGHT_TEXT=0.25
WEIGHT_HTML=0.15

# Risk Thresholds
THRESHOLD_SAFE=0.30
THRESHOLD_SUSPICIOUS=0.65

# Security & Sandboxing Settings
SSRF_PROTECTION_ENABLED=True
ALLOW_LOCAL_TEST_PAGES=True
PAGE_FETCH_TIMEOUT_SECONDS=10
MAX_HTML_SIZE_BYTES=5242880

# Database
DATABASE_URL=sqlite:///./backend/data/phishing_scans.db

